// Converts a colour frame to tightly packed NV12 (BT.709, limited range), four bytes packed in each uint: the Y plane, then
// one plane of U and V interleaved. The width must be a multiple of 8 and the height a multiple of 2; the recording rounds
// both sides to multiples of 16. BT.709 because a player that ignores the colour the stream states assumes it for HD video.
#pragma kernel LumaKernel
#pragma kernel ChromaKernel

Texture2D<float4> Source;
RWStructuredBuffer<uint> Output;
uint Width;
uint Height;
uint FlipVertically;
uint SourceIsLinear;
// Where the picture lies in the video, top first, right and bottom outside it; black around it when the screen's shape changed.
uint PictureLeft;
uint PictureTop;
uint PictureRight;
uint PictureBottom;

float3 LinearToSrgb(float3 c)
{
    // Used only above the straight part of the curve, where abs changes nothing and keeps compilers from warning of negatives.
    return c <= 0.0031308 ? c * 12.92 : 1.055 * pow(abs(c), 1.0 / 2.4) - 0.055;
}

// Whether the source's first row is the top of the picture depends on the graphics API; the video's first row is the top.
// The source is read only inside the picture, and black is left around it; one return, since an early one makes the Vulkan and
// OpenGL ES compilers warn of an unset value.
float3 Pixel(uint x, uint y)
{
    float3 picture = float3(0, 0, 0);
    if (x >= PictureLeft && x < PictureRight && y >= PictureTop && y < PictureBottom)
    {
        uint row = FlipVertically != 0 ? Height - 1 - y : y;
        // A linear-colour project reads its sRGB texture back as linear values; a gamma project reads the stored values as they are.
        float3 c = Source.Load(int3(x, row, 0)).rgb;
        picture = saturate(SourceIsLinear != 0 ? LinearToSrgb(c) : c);
    }
    return picture;
}

uint Luma(float3 c) { return (uint)round(16.0 + 46.559 * c.r + 156.629 * c.g + 15.812 * c.b); }
uint Blue(float3 c) { return (uint)round(128.0 - 25.664 * c.r - 86.336 * c.g + 112.0 * c.b); }
uint Red(float3 c) { return (uint)round(128.0 + 112.0 * c.r - 101.730 * c.g - 10.270 * c.b); }

// One thread per four pixels of a row: one uint of the Y plane.
[numthreads(64, 1, 1)]
void LumaKernel(uint3 id : SV_DispatchThreadID)
{
    uint wordsPerRow = Width / 4;
    if (id.x >= wordsPerRow * Height) return;
    uint y = id.x / wordsPerRow;
    uint x = (id.x % wordsPerRow) * 4;
    uint word = 0;
    for (uint i = 0; i < 4; i++)
    {
        word |= (Luma(Pixel(x + i, y)) & 0xFF) << (8 * i);
    }
    Output[id.x] = word;
}

// One thread per two chroma samples (a 4x2 block of pixels): one uint of the interleaved plane, U V U V.
[numthreads(64, 1, 1)]
void ChromaKernel(uint3 id : SV_DispatchThreadID)
{
    uint chromaHeight = Height / 2;
    uint wordsPerRow = Width / 4;
    if (id.x >= wordsPerRow * chromaHeight) return;
    uint cy = id.x / wordsPerRow;
    uint cx = (id.x % wordsPerRow) * 2;
    uint word = 0;
    for (uint i = 0; i < 2; i++)
    {
        uint px = (cx + i) * 2;
        uint py = cy * 2;
        float3 c = (Pixel(px, py) + Pixel(px + 1, py) + Pixel(px, py + 1) + Pixel(px + 1, py + 1)) * 0.25;
        word |= (Blue(c) & 0xFF) << (16 * i);
        word |= (Red(c) & 0xFF) << (16 * i + 8);
    }
    Output[(Width * Height) / 4 + id.x] = word;
}
